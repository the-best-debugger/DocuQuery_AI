PORT=8000
FRONTEND_URL=http://localhost:5173

# LLM Configuration
# Choose: gemini | groq | openai | mock
LLM_PROVIDER=gemini

# Free Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Free Groq API Key (Optional alternative at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
